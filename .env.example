PORT=3001
DATABASE_URL=./data/projeto41.sqlite

# Porta da previa ao vivo mantida pelo supervisor (npm run serve); a API de
# testes usa a porta seguinte (4142). 0 desliga a previa.
PROJETO41_PREVIEW_PORT=4141

# Token gratuito da brapi (https://brapi.dev) para cotacoes da B3.
BRAPI_TOKEN=

# Chave opcional do plano Demo do CoinGecko (https://www.coingecko.com/en/api).
# As cotacoes de cripto usam o endpoint /simple/price (1 chamada para todos
# os ativos). Sem chave funciona via API publica, com limite menor.
COINGECKO_API_KEY=

# Fuso usado para o snapshot diario de patrimonio.
TZ=America/Fortaleza
